# Copy to .env.local and fill in.

# Postgres connection string (Neon, Supabase or local)
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Protects the manager dashboard when it is reachable through a tunnel
DASHBOARD_PASSWORD=

# OpenRouter: one key for both Jev and the chat model
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.13
LLM_MODEL=openai/gpt-6-sol
UNDERSTANDING_MODE=jev_then_llm

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_TEMPLATE_NAME=hello_world
WHATSAPP_TEMPLATE_LANG=en_US
WHATSAPP_TEMPLATE_HAS_BODY_PARAM=false

# Optional Google Sheets roster export
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Roster

AGENT_TICK_SECONDS=30

# Live Mode (/live): judges join as crew through a Telegram bot. Create one with @BotFather.
TELEGRAM_BOT_TOKEN=
# Optional: only if deployed publicly and you register /api/telegram/webhook with setWebhook.
# Leave empty to long-poll (works on a laptop with no tunnel).
TELEGRAM_WEBHOOK_SECRET=

# Optional: Google Maps Embed API key for the map at the top of /live (restrict it to your domain).
# Without it the page uses Google's keyless map embed.
GOOGLE_MAPS_EMBED_KEY=
# Optional: public address of this app, used for the /leave link the Telegram bot sends (e.g. https://yourapp.onrender.com)
LIVE_PUBLIC_URL=
